---
layout: base.njk
---
<article>
  <header class="post-header">
    <h1>{{ title }}</h1>
    {%- if page.date %}
    <time datetime="{{ page.date.toISOString() }}">{{ page.date.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric', timeZone: 'UTC' }) }}</time>
    {%- endif %}
  </header>
  {{ content | safe }}
</article>
